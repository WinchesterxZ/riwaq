# Copy to apps/api/.env and replace the example credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/atlas_erp_dev
TEST_DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/atlas_erp_test
API_PORT=3000
WEB_PORT=5173
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_PER_MIN=10
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
