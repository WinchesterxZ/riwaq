  organizationId  String   @map("organization_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  number          String   @db.VarChar(30) // GRN-000001
  status          String   @default("draft") @db.VarChar(20) // draft|posted|cancelled
  receiptDate     DateTime @map("receipt_date") @db.Date
  notes           String?  @db.Text
  idempotencyKey  String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy     User?              @relation("GoodsReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String  @id @default(uuid()) @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String  @map("purchase_order_line_id") @db.Uuid
  productId           String  @map("product_id") @db.Uuid
  quantity            Decimal @db.Decimal(19, 4)
  unitCost            Decimal @map("unit_cost") @db.Decimal(19, 4)

  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine  @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  supplierBillLines SupplierBillLine[]

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

model SupplierBill {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  goodsReceiptId  String?   @map("goods_receipt_id") @db.Uuid
  number          String    @db.VarChar(30) // BILL-000001
  supplierRef     String?   @map("supplier_ref") @db.VarChar(60)
  status          String    @default("draft") @db.VarChar(20) // draft|submitted|approved|posted|partially_paid|paid
  billDate        DateTime  @map("bill_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  subtotal        Decimal   @db.Decimal(19, 4)
  taxTotal        Decimal   @map("tax_total") @db.Decimal(19, 4)
  total           Decimal   @db.Decimal(19, 4)
  paidTotal       Decimal   @default(0) @map("paid_total") @db.Decimal(19, 4)
  outstanding     Decimal   @db.Decimal(19, 4)
  currency        String    @db.VarChar(3)
  notes           String?   @db.Text
  approvedById    String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  idempotencyKey  String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdById     String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder?              @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  approvedBy         User?                       @relation("SupplierBillApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy          User?                       @relation("SupplierBillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines              SupplierBillLine[]
  paymentAllocations SupplierPaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([supplierId])
  @@map("supplier_bills")
}

model SupplierBillLine {
  id                  String  @id @default(uuid()) @db.Uuid
  supplierBillId      String  @map("supplier_bill_id") @db.Uuid
  purchaseOrderLineId String? @map("purchase_order_line_id") @db.Uuid
  goodsReceiptLineId  String? @map("goods_receipt_line_id") @db.Uuid
  productId           String? @map("product_id") @db.Uuid
  description         String  @db.VarChar(255)
  quantity            Decimal @db.Decimal(19, 4)
  unitPrice           Decimal @map("unit_price") @db.Decimal(19, 4)
  discountRate        Decimal @default(0) @map("discount_rate") @db.Decimal(8, 4)
  taxRate             Decimal @default(0) @map("tax_rate") @db.Decimal(8, 4)
  lineTotal           Decimal @map("line_total") @db.Decimal(19, 4)

  supplierBill      SupplierBill       @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  goodsReceiptLine  GoodsReceiptLine?  @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([supplierBillId])
  @@map("supplier_bill_lines")
}

model SupplierPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
