  @@index([supplierPaymentId])
  @@map("supplier_payment_allocations")
}

model BankStatement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  number         String   @db.VarChar(30) // BS-000001
  status         String   @default("draft") @db.VarChar(20) // draft|posted
  statementDate  DateTime @map("statement_date") @db.Date
  openingBalance Decimal  @map("opening_balance") @db.Decimal(19, 4)
  closingBalance Decimal  @map("closing_balance") @db.Decimal(19, 4)
  notes          String?  @db.Text
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account      Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("BankStatementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines        BankStatementLine[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([accountId])
  @@map("bank_statements")
}

model BankStatementLine {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  bankStatementId      String    @map("bank_statement_id") @db.Uuid
  lineNo               Int       @map("line_no")
  valueDate            DateTime  @map("value_date") @db.Date
  description          String    @db.VarChar(400)
  reference            String?   @db.VarChar(120)
  amount               Decimal   @db.Decimal(19, 4) // signed: +inflow, -outflow
  reconciledEntryId    String?   @map("reconciled_entry_id") @db.Uuid
  reconciledAt         DateTime? @map("reconciled_at") @db.Timestamptz
  reconciledById       String?   @map("reconciled_by") @db.Uuid

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankStatement    BankStatement  @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  reconciledEntry  JournalEntry?  @relation("StatementLineMatch", fields: [reconciledEntryId], references: [id], onDelete: SetNull)
  reconciledBy     User?          @relation("StatementLineReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)

  @@index([bankStatementId])
  @@index([reconciledEntryId])
  @@map("bank_statement_lines")
}

model ExpenseBill {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
