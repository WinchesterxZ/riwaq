model ExpenseBillLine {
  id            String  @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  expenseBillId String  @map("expense_bill_id") @db.Uuid
  accountId     String  @map("account_id") @db.Uuid
  description   String  @db.VarChar(400)
  quantity      Decimal @db.Decimal(19, 4)
  unitPrice     Decimal @map("unit_price") @db.Decimal(19, 4)
  taxRate       Decimal @map("tax_rate") @db.Decimal(9, 4)
  lineTotal     Decimal @map("line_total") @db.Decimal(19, 4)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(19, 4)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  expenseBill  ExpenseBill  @relation(fields: [expenseBillId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([expenseBillId])
  @@map("expense_bill_lines")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(60)
  titleAr        String    @map("title_ar") @db.VarChar(300)
  titleEn        String    @map("title_en") @db.VarChar(300)
  bodyAr         String?   @map("body_ar")
  bodyEn         String?   @map("body_en")
  link           String?   @db.VarChar(500)
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_created_idx")
  @@map("notifications")
}
