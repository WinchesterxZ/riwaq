// ATLAS ERP — Phase 2 slice: identity, organization, RBAC, audit, settings.
// Later phases add accounting/inventory/sales/purchasing models via new migrations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(120)
  nameAr          String   @map("name_ar") @db.VarChar(120)
  defaultCurrency String   @map("default_currency") @db.VarChar(3)
  defaultTimezone String   @map("default_timezone") @db.VarChar(60)
  status          String   @default("active") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  companies   Company[]
  memberships Membership[]
  roles       Role[]
  auditEvents AuditEvent[]
  notifications Notification[]

  // Phase 5: inventory
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  adjustments       InventoryAdjustment[]
  transfers         InventoryTransfer[]
  counts            InventoryCount[]

  // Phase 6: sales
  quotations         Quotation[]
  salesOrders        SalesOrder[]
  deliveries         Delivery[]
  salesInvoices      SalesInvoice[]
  salesPayments      SalesPayment[]
  paymentAllocations PaymentAllocation[]
  creditNotes        CreditNote[]

  // Phase 7: purchasing
  purchaseRequests           PurchaseRequest[]
  rfqs                       Rfq[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  supplierBills              SupplierBill[]
  supplierPayments           SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]

  // Phase 8: finance
  bankStatements     BankStatement[]
  bankStatementLines BankStatementLine[]
  expenseBills       ExpenseBill[]
  expenseBillLines   ExpenseBillLine[]

  @@map("organizations")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(120)
  nameAr         String   @map("name_ar") @db.VarChar(120)
  baseCurrency   String   @map("base_currency") @db.VarChar(3)
  taxId          String?  @map("tax_id") @db.VarChar(60)
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branches     Branch[]

  makerCheckerJournal Boolean @default(false) @map("maker_checker_journal")

  accounts       Account[]
  fiscalYears    FiscalYear[]
  taxCodes       TaxCode[]
  journalEntries JournalEntry[]

  // Phase 5: inventory
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  adjustments       InventoryAdjustment[]
  transfers         InventoryTransfer[]
  counts            InventoryCount[]

  // Phase 4: shared master data
  customers         Customer[]
  suppliers         Supplier[]
  paymentTerms      PaymentTerm[]
  productCategories ProductCategory[]
  products          Product[]
  productVariants   ProductVariant[]
  documentSequences DocumentSequence[]

  // Phase 6: sales
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  deliveries    Delivery[]
  salesInvoices SalesInvoice[]
  salesPayments SalesPayment[]
  creditNotes   CreditNote[]

  // Phase 7: purchasing
  purchaseRequests PurchaseRequest[]
  rfqs             Rfq[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]

  // Phase 8: finance
  bankStatements BankStatement[]
  expenseBills   ExpenseBill[]

  @@index([organizationId])
  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(120)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouses Warehouse[]

  @@index([companyId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String   @db.VarChar(120)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch    Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  locations StorageLocation[]

  // Phase 5: inventory
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  adjustments       InventoryAdjustment[]
  transfersFrom     InventoryTransfer[]   @relation("TransferSource")
  transfersTo       InventoryTransfer[]   @relation("TransferDest")
  counts            InventoryCount[]

  // Phase 6: sales
  salesOrders SalesOrder[]
  deliveries  Delivery[]

  // Phase 7: purchasing
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@index([branchId])
  @@map("warehouses")
}

model StorageLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code        String   @db.VarChar(40)
  nameAr      String   @map("name_ar") @db.VarChar(120)
  nameEn      String?  @map("name_en") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // Phase 5: inventory
  stockMovements StockMovement[]

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash")
  name           String    @db.VarChar(120)
  status         String    @default("active") @db.VarChar(20) // active | inactive | locked
  mfaSecret      String?   @map("mfa_secret")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]
  sessions    Session[]
  auditEvents AuditEvent[]
  notifications Notification[]
  resetTokens PasswordResetToken[]
  invitations Invitation[]         @relation("InvitationCreator")

  createdAccounts Account[]          @relation("AccountCreator")
  postedJournals  JournalEntry[]     @relation("JournalPoster")
  closedPeriods   AccountingPeriod[] @relation("PeriodCloser")

  // Phase 4: master data
  customerSalesperson Customer[]   @relation("CustomerSalesperson")
  supplierSalesperson Supplier[]   @relation("SupplierSalesperson")
  createdCustomers    Customer[]   @relation("CustomerCreator")
  createdSuppliers    Supplier[]   @relation("SupplierCreator")
  createdProducts     Product[]    @relation("ProductCreator")
  uploadedAttachments Attachment[] @relation("AttachmentUploader")

  // Phase 5: inventory
  createdMovements StockMovement[] @relation("MovementCreator")

  // Phase 6: sales
  createdQuotations    Quotation[]    @relation("QuotationCreator")
  createdSalesOrders   SalesOrder[]   @relation("SalesOrderCreator")
  createdDeliveries    Delivery[]     @relation("DeliveryCreator")
  createdSalesInvoices SalesInvoice[] @relation("SalesInvoiceCreator")
  createdSalesPayments SalesPayment[] @relation("SalesPaymentCreator")
  createdCreditNotes   CreditNote[]   @relation("CreditNoteCreator")

  // Phase 7: purchasing
  requestedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestRequester")
  approvedPurchaseRequests  PurchaseRequest[] @relation("PurchaseRequestApprover")
  createdPurchaseRequests   PurchaseRequest[] @relation("PurchaseRequestCreator")
  createdRfqs               Rfq[]             @relation("RfqCreator")
  requestedPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderRequester")
  approvedPurchaseOrders    PurchaseOrder[]   @relation("PurchaseOrderApprover")
  createdPurchaseOrders     PurchaseOrder[]   @relation("PurchaseOrderCreator")
  createdGoodsReceipts      GoodsReceipt[]    @relation("GoodsReceiptCreator")
  approvedSupplierBills     SupplierBill[]    @relation("SupplierBillApprover")
  createdSupplierBills      SupplierBill[]    @relation("SupplierBillCreator")
  createdSupplierPayments   SupplierPayment[] @relation("SupplierPaymentCreator")

  // Phase 8: finance
  createdBankStatements    BankStatement[]     @relation("BankStatementCreator")
  reconciledStatementLines BankStatementLine[] @relation("StatementLineReconciler")
  createdExpenseBills      ExpenseBill[]       @relation("ExpenseBillCreator")

  @@map("users")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles        UserRole[]
  companies    MembershipCompany[]
  branches     MembershipBranch[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model MembershipCompany {
  membershipId String @map("membership_id") @db.Uuid
  companyId    String @map("company_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@map("membership_companies")
}

model MembershipBranch {
  membershipId String @map("membership_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@map("membership_branches")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid // null = system role
  name           String   @db.VarChar(120)
  nameAr         String   @map("name_ar") @db.VarChar(120)
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  userRoles    UserRole[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String @db.VarChar(60)
  action   String @db.VarChar(40)

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  ip        String?   @db.VarChar(60)
  userAgent String?   @map("user_agent") @db.VarChar(300)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  tokenHash      String    @unique @map("token_hash")
  roleIds        Json      @map("role_ids")
  companyIds     Json      @default("[]") @map("company_ids")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz
  createdById    String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  createdBy User @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("invitations")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model IdempotencyKey {
  key       String   @id @db.VarChar(100)
  userId    String   @map("user_id") @db.Uuid
  status    Int
  body      Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("idempotency_keys")
}

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String?  @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.VarChar(80)
  diff           Json?
  ip             String?  @db.VarChar(60)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("audit_events")
}

model Currency {
  code     String @id @db.VarChar(3)
  nameAr   String @map("name_ar") @db.VarChar(80)
  nameEn   String @map("name_en") @db.VarChar(80)
  decimals Int    @default(2)

  suppliers Supplier[] // Phase 4: supplier default currency

  @@map("currencies")
}

model DocumentSequence {
  id           String @id @default(uuid()) @db.Uuid
  companyId    String @map("company_id") @db.Uuid
  documentType String @map("document_type") @db.VarChar(60)
  prefix       String @db.VarChar(20)
  nextNumber   Int    @default(1) @map("next_number")

  // Phase 4: yearly reset support.
  resetPolicy   String @default("never") @map("reset_policy") @db.VarChar(10) // never | yearly
  lastResetYear Int?   @map("last_reset_year")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentType])
  @@map("document_sequences")
}

model SystemSetting {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  companyId      String? @map("company_id") @db.Uuid
  key            String  @db.VarChar(120)
  value          Json

  @@unique([key, organizationId, companyId])
  @@map("system_settings")
}

// ─── Phase 3: financial accounting foundation ───

model AccountType {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(20) // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  nameAr String @map("name_ar") @db.VarChar(80)
  nameEn String @map("name_en") @db.VarChar(80)

  accounts Account[]

  @@map("account_types")
}

model Account {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  code          String   @db.VarChar(30)
  nameAr        String   @map("name_ar") @db.VarChar(160)
  nameEn        String   @map("name_en") @db.VarChar(160)
  accountTypeId String   @map("account_type_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  isPostable    Boolean  @default(true) @map("is_postable")
  isActive      Boolean  @default(true) @map("is_active")
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdById   String?  @map("created_by") @db.Uuid

  company              Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type                 AccountType   @relation(fields: [accountTypeId], references: [id], onDelete: Restrict)
  parent               Account?      @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Account[]     @relation("AccountHierarchy")
  createdBy            User?         @relation("AccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines                JournalLine[]
  taxCodes             TaxCode[]

  // Phase 8: finance
  bankStatements      BankStatement[]
  expenseBillBankUses ExpenseBill[]     @relation("ExpenseBillBankAccount")
  expenseBillLines    ExpenseBillLine[]
  // Phase 4: products referencing this account as inventory / COGS / revenue.
  inventoryForProducts Product[]     @relation("ProductInventoryAccount")
  cogsForProducts      Product[]     @relation("ProductCogsAccount")
  revenueForProducts   Product[]     @relation("ProductRevenueAccount")

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
  @@map("accounts")
}

model FiscalYear {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(80)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String   @default("open") @db.VarChar(20) // open | closed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periods AccountingPeriod[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String    @id @default(uuid()) @db.Uuid
  fiscalYearId String    @map("fiscal_year_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  name         String    @db.VarChar(80)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  status       String    @default("open") @db.VarChar(20) // open | closed | locked
  closedById   String?   @map("closed_by") @db.Uuid
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  fiscalYear FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  closedBy   User?          @relation("PeriodCloser", fields: [closedById], references: [id], onDelete: SetNull)
  entries    JournalEntry[]

  @@unique([fiscalYearId, name])
  @@index([companyId, status])
  @@map("accounting_periods")
}

model TaxCode {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  nameAr       String   @map("name_ar") @db.VarChar(120)
  nameEn       String   @map("name_en") @db.VarChar(120)
  rate         Decimal  @db.Decimal(8, 4)
  type         String   @db.VarChar(20) // input | output | exempt | zero
  taxAccountId String?  @map("tax_account_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  taxAccount Account?      @relation(fields: [taxAccountId], references: [id], onDelete: Restrict)
  lines      JournalLine[]
  products   Product[] // Phase 4: products referencing this tax code

  @@unique([companyId, nameEn])
  @@index([companyId])
  @@map("tax_codes")
}

model TaxTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  taxCodeId  String   @map("tax_code_id") @db.Uuid
  sourceType String   @map("source_type") @db.VarChar(60)
  sourceId   String   @map("source_id") @db.Uuid
  baseAmount Decimal  @map("base_amount") @db.Decimal(19, 4)
  taxAmount  Decimal  @map("tax_amount") @db.Decimal(19, 4)
  taxDate    DateTime @map("tax_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId, taxDate])
  @@map("tax_transactions")
}

model JournalEntry {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  periodId       String?   @map("period_id") @db.Uuid
  journalType    String    @map("journal_type") @db.VarChar(30) // manual | reversal | opening
  postingDate    DateTime  @map("posting_date") @db.Date
  currency       String    @db.VarChar(3)
  exchangeRate   Decimal   @map("exchange_rate") @db.Decimal(19, 6)
  description    String    @db.Text
  sourceType     String?   @map("source_type") @db.VarChar(60)
  sourceId       String?   @map("source_id") @db.Uuid
  status         String    @default("draft") @db.VarChar(20) // draft | submitted | approved | posted | reversed
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(100)
  reversalOfId   String?   @map("reversal_of_id") @db.Uuid
  postedById     String?   @map("posted_by") @db.Uuid
  postedAt       DateTime? @map("posted_at") @db.Timestamptz
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdById    String?   @map("created_by") @db.Uuid

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period     AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reversalOf JournalEntry?     @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals  JournalEntry[]    @relation("JournalReversal")
  postedBy   User?             @relation("JournalPoster", fields: [postedById], references: [id], onDelete: SetNull)
  lines      JournalLine[]

  // Phase 6: sales
  salesInvoices SalesInvoice[]
  salesPayments SalesPayment[]
  creditNotes   CreditNote[]

  // Phase 8: finance
  matchedStatementLines BankStatementLine[] @relation("StatementLineMatch")
  expenseBills          ExpenseBill[]

  @@index([companyId, status])
  @@index([companyId, postingDate])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  debit          Decimal  @db.Decimal(19, 4)
  credit         Decimal  @db.Decimal(19, 4)
  description    String?  @db.Text
  costCenter     String?  @map("cost_center") @db.VarChar(80)
  taxCodeId      String?  @map("tax_code_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  entry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  taxCode TaxCode?     @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─── Phase 4: shared master data ───

model PaymentTerm {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nameAr    String   @map("name_ar") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
