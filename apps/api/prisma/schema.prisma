  from UnitOfMeasure @relation("ConversionFrom", fields: [fromUomId], references: [id], onDelete: Restrict)
  to   UnitOfMeasure @relation("ConversionTo", fields: [toUomId], references: [id], onDelete: Restrict)

  @@unique([fromUomId, toUomId])
  @@map("unit_conversions")
}

model Product {
  id                  String   @id @default(uuid()) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  sku                 String   @db.VarChar(60)
  nameAr              String   @map("name_ar") @db.VarChar(200)
  nameEn              String   @map("name_en") @db.VarChar(200)
  type                String   @default("stocked") @db.VarChar(20) // stocked | non_stock | service
  categoryId          String?  @map("category_id") @db.Uuid
  baseUomId           String   @map("base_uom_id") @db.Uuid
  purchasePrice       Decimal? @map("purchase_price") @db.Decimal(19, 4)
  salesPrice          Decimal? @map("sales_price") @db.Decimal(19, 4)
  taxCodeId           String?  @map("tax_code_id") @db.Uuid
  reorderLevel        Decimal? @map("reorder_level") @db.Decimal(19, 4)
  preferredSupplierId String?  @map("preferred_supplier_id") @db.Uuid
  inventoryAccountId  String?  @map("inventory_account_id") @db.Uuid
  cogsAccountId       String?  @map("cogs_account_id") @db.Uuid
  revenueAccountId    String?  @map("revenue_account_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdById         String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category          ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUom           UnitOfMeasure    @relation(fields: [baseUomId], references: [id], onDelete: Restrict)
  taxCode           TaxCode?         @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  preferredSupplier Supplier?        @relation(fields: [preferredSupplierId], references: [id], onDelete: Restrict)
  inventoryAccount  Account?         @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccount       Account?         @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id], onDelete: Restrict)
  revenueAccount    Account?         @relation("ProductRevenueAccount", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  createdBy         User?            @relation("ProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  variants          ProductVariant[]

  // Phase 5: inventory
  stockMovements    StockMovement[]
  stockReservations StockReservation[]
  adjustmentLines   InventoryAdjustmentLine[]
  transferLines     InventoryTransferLine[]
  countLines        InventoryCountLine[]

  // Phase 6: sales
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  deliveryLines     DeliveryLine[]
  salesInvoiceLines SalesInvoiceLine[]
  creditNoteLines   CreditNoteLine[]

  // Phase 7: purchasing
  purchaseRequestLines PurchaseRequestLine[]
  rfqLines             RfqLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  supplierBillLines    SupplierBillLine[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, type])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid // denormalized for the per-company SKU uniqueness
  productId  String   @map("product_id") @db.Uuid
  sku        String   @db.VarChar(60)
  attributes Json     @default("{}")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([companyId, sku])
  @@index([productId])
  @@map("product_variants")
}

// Polymorphic file attachments. Files live on local disk (STORAGE_DIR);
// file_key is the random storage name, file_name the original name.
// NOTE (future): swap StorageService to an S3-compatible backend behind the
// same interface; the file_key layout (uuid + extension) is already S3-safe.
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ownerType    String   @map("owner_type") @db.VarChar(40) // customer | supplier | product | product_category
  ownerId      String   @map("owner_id") @db.Uuid
  fileKey      String   @unique @map("file_key") @db.VarChar(255)
  fileName     String   @map("file_name") @db.VarChar(255)
  mime         String   @db.VarChar(120)
  size         Int
  uploadedById String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([ownerType, ownerId])
  @@map("attachments")
}

// ================= INVENTORY ENGINE (Phase 5) =================
// Design notes:
// - Stock is NEVER an editable column. Every quantity change is an immutable
//   StockMovement row; balances are derived (sum of movements, reservations).
// - Valuation is perpetual weighted-average. The math lives in
//   src/inventory/valuation.ts behind a ValuationPolicy interface so FIFO can
//   be added later without touching the service.
// - Concurrency: mutating operations take SELECT ... FOR UPDATE on the product
//   row inside their transaction, serializing per-product inventory writes and
//   making "available >= qty" checks race-safe.

model StockMovement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  movementType   String   @map("movement_type") @db.VarChar(20) // receive|issue|transfer_in|transfer_out|adjustment|return|opening
  quantity       Decimal  @db.Decimal(19, 4) // signed: + in, - out
  unitCost       Decimal  @map("unit_cost") @db.Decimal(19, 4)
  totalCost      Decimal  @map("total_cost") @db.Decimal(19, 4) // signed, quantity * unitCost
  sourceType     String?  @map("source_type") @db.VarChar(40)
  sourceId       String?  @map("source_id") @db.Uuid
  movementDate   DateTime @map("movement_date") @db.Date
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse      Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location       StorageLocation?         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy      User?                    @relation("MovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  valuationEntry InventoryValuationEntry?

  @@index([companyId, warehouseId, productId])
  @@index([productId, movementDate])
  @@index([sourceType, sourceId])
  @@map("stock_movements")
}

model StockReservation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  warehouseId    String   @map("warehouse_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  quantity       Decimal  @db.Decimal(19, 4)
  status         String   @default("active") @db.VarChar(20) // active|released|consumed
  sourceType     String?  @map("source_type") @db.VarChar(40)
  sourceId       String?  @map("source_id") @db.Uuid
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(100)
  createdById    String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId, warehouseId, productId, status])
  @@map("stock_reservations")
}

model InventoryValuationEntry {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  movementId       String   @unique @map("movement_id") @db.Uuid
  quantityDelta    Decimal  @map("quantity_delta") @db.Decimal(19, 4)
  costDelta        Decimal  @map("cost_delta") @db.Decimal(19, 4)
  resultingQty     Decimal  @map("resulting_qty") @db.Decimal(19, 4)
  resultingAvgCost Decimal  @map("resulting_avg_cost") @db.Decimal(19, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  movement StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)

  @@index([companyId, warehouseId, productId])
  @@map("inventory_valuation_entries")
}

model InventoryAdjustment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  warehouseId    String    @map("warehouse_id") @db.Uuid
  number         String    @db.VarChar(40)
  status         String    @default("draft") @db.VarChar(20) // draft|submitted|approved|posted|cancelled
  reason         String?   @db.VarChar(500)
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdById    String?   @map("created_by") @db.Uuid
  approvedById   String?   @map("approved_by") @db.Uuid
  postedAt       DateTime? @map("posted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse    Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
