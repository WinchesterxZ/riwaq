  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customers Customer[]
  suppliers Supplier[]

  @@index([companyId])
  @@map("payment_terms")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  number        String   @db.VarChar(30) // auto-allocated from document_sequences (never collides)
  nameAr        String   @map("name_ar") @db.VarChar(160)
  nameEn        String   @map("name_en") @db.VarChar(160)
  kind          String   @default("company") @db.VarChar(20) // individual | company
  taxId         String?  @map("tax_id") @db.VarChar(60)
  paymentTermId String?  @map("payment_term_id") @db.Uuid
  creditLimit   Decimal? @map("credit_limit") @db.Decimal(19, 4)
  status        String   @default("active") @db.VarChar(20) // active | inactive
  salespersonId String?  @map("salesperson_id") @db.Uuid
  createdById   String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  salesperson User?        @relation("CustomerSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Phase 6: sales
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]
  salesPayments SalesPayment[]
  creditNotes   CreditNote[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@map("customers")
}

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  number          String   @db.VarChar(30) // auto-allocated from document_sequences (never collides)
  nameAr          String   @map("name_ar") @db.VarChar(160)
  nameEn          String   @map("name_en") @db.VarChar(160)
  kind            String   @default("company") @db.VarChar(20) // individual | company
  taxId           String?  @map("tax_id") @db.VarChar(60)
  paymentTermId   String?  @map("payment_term_id") @db.Uuid
  creditLimit     Decimal? @map("credit_limit") @db.Decimal(19, 4)
  defaultCurrency String   @map("default_currency") @db.VarChar(3)
  status          String   @default("active") @db.VarChar(20) // active | inactive
  salespersonId   String?  @map("salesperson_id") @db.Uuid
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentTerm PaymentTerm? @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  currency    Currency     @relation(fields: [defaultCurrency], references: [code], onDelete: Restrict)
  salesperson User?        @relation("SupplierSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)
  products    Product[] // preferred-supplier back-reference

  // Phase 7: purchasing
  rfqs             Rfq[]
  rfqLines         RfqLine[]
  purchaseOrders   PurchaseOrder[]
  supplierBills    SupplierBill[]

  // Phase 8: finance
  expenseBills     ExpenseBill[]
  supplierPayments SupplierPayment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@map("suppliers")
}

