  @@index([companyId])
  @@index([parentId])
  @@map("product_categories")
}

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20) // global vocabulary, e.g. PCS, KG
  nameAr    String   @map("name_ar") @db.VarChar(80)
  nameEn    String   @map("name_en") @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromConversions UnitConversion[] @relation("ConversionFrom")
  toConversions   UnitConversion[] @relation("ConversionTo")
