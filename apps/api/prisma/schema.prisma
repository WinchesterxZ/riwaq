model PurchaseRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  number         String    @db.VarChar(30) // PR-000001 (document_sequences, race-safe)
  status         String    @default("draft") @db.VarChar(20) // draft|submitted|approved|rejected|partially_ordered|ordered|closed|cancelled
  requestedById  String?   @map("requested_by") @db.Uuid
  approvedById   String?   @map("approved_by") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz
  subtotal       Decimal   @db.Decimal(19, 4)
  total          Decimal   @db.Decimal(19, 4)
  currency       String    @db.VarChar(3)
  notes          String?   @db.Text
  idempotencyKey String?   @unique @map("idempotency_key") @db.VarChar(100)
  createdById    String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy    User?                 @relation("PurchaseRequestRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy     User?                 @relation("PurchaseRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy      User?                 @relation("PurchaseRequestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines          PurchaseRequestLine[]
  purchaseOrders PurchaseOrder[]
  rfqs           Rfq[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String  @id @default(uuid()) @db.Uuid
