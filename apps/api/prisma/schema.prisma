}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  ownerType  String   @map("owner_type") @db.VarChar(20) // customer | supplier
  ownerId    String   @map("owner_id") @db.Uuid
  label      String?  @db.VarChar(80)
